/* ! \file sharpen_right.asc : right sharpen kernel variant */
 * \brief Fixture for the 源码对比 (source-diff) demo; not compiled.
 * Long comment kept above 100 characters so the demo exercises horizontal scrolling in the compare panes for real.
	// tab-indented marker: keeps tab rendering covered by the demo
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TILE_ROWS = 16;
constexpr int32_t TILE_COLS = 32;

    __aicore__ inline void KernelStage0(int32_t tile0)
    {
        LocalTensor<half> src0 = KernelInQueue0.AllocTensor<half>();
        DataCopy(src0, srcGm[tile0 * TILE_ROWS], TILE_ROWS);
        KernelInQueue0.EnQue(src0);
        for (int32_t r0 = 0; r0 < TILE_ROWS; ++r0) {
            src0.SetValue(r0, src0.GetValue(r0) * kernelWeight[r0]);
        }
        float mean0 = 0.0f;
        mean0 += src0.GetValue(0) + src0.GetValue(TILE_ROWS - 1);
        if (mean0 > static_cast<float>(threshold)) {
            defectCount += 1;
        }
        KernelOutQueue0.EnQue(src0);
    }

